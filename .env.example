# ==========================================
# ScholMart Production Environment Configuration
# ==========================================

# Application
NEXT_PUBLIC_APP_NAME="ScholMart"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholmart?schema=public"

# Authentication & Security
NEXTAUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Redis Cache & Background Jobs (BullMQ)
REDIS_URL="redis://localhost:6379"

# Cloud Storage (AWS S3 or Cloudinary for logos, CAD designs, invoices)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret"
AWS_S3_BUCKET="scholmart-assets"

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_SECRET="YourRazorpaySecret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyId"

# Email Delivery (Resend / SMTP)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="orders@scholmart.com"

# WhatsApp Business API (Gupshup / Twilio / Meta Cloud API)
WHATSAPP_API_TOKEN="your_whatsapp_bearer_token"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"

# Multi-tenant Configuration
ENABLE_MULTI_TENANCY="true"
DEFAULT_CURRENCY="INR"
